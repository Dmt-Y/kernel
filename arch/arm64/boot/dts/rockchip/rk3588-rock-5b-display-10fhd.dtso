/*
 * DT-overlay for Radxa 10FHD display. This display comes with Goodix
 * touchscreen and built-in Silan Microelectronics acceleration sensor.
 * Configured for use with Radxa ROCK 5B.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>


&{/} {
	lcd_3v3: regulator-3v3-lcd {
		compatible = "regulator-fixed";
		regulator-name = "lcd_3v3";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio1 RK_PC4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_pwren_h>;
		vin-supply = <&vcc_3v3_s3>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2 0 25000 0>;
		enable-gpios = <&gpio2 RK_PC2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_light_en>;
	};
};

&dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "radxa,display-10fhd";
		reg = <0>;
		backlight = <&backlight>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_reset>;
		reset-gpios = <&gpio2 RK_PC1 GPIO_ACTIVE_HIGH>;
		vccio-supply = <&vcc_1v8_s0>;
		vdd-supply = <&lcd_3v3>;

		port {
			panel_in_dsi1: endpoint {
				remote-endpoint = <&dsi1_out_panel>;
			};
		};
	};
};

&dsi1_in {
	dsi1_in_vp3: endpoint {
		remote-endpoint = <&vp3_out_dsi1>;
	};
};

&dsi1_out {
	dsi1_out_panel: endpoint {
		remote-endpoint = <&panel_in_dsi1>;
	};
};

&i2c6 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;

	touchscreen@14 {
		compatible = "goodix,gt9271";
		reg = <0x14>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD3 IRQ_TYPE_LEVEL_HIGH>;
		irq-gpios = <&gpio0 RK_PD3 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&tp_int_l &tp_rst_l>;
		reset-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
		AVDD28-supply = <&lcd_3v3>;
		VDDIO-supply = <&vcc_1v8_s0>;
	};

	accelerometer@19 {
		compatible = "silan,sc7a20";
		reg = <0x19>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&accel_int>;
		st,drdy-int-pin = <1>;
		vdd-supply = <&lcd_3v3>;
		vddio-supply = <&vcc_1v8_s0>;

		mount-matrix = "1", "0", "0",
			       "0", "-1", "0",
			       "0", "0", "1";
	};
};

&mipidcphy1 {
	status = "okay";
};

&pinctrl {
	accelerometer {
		accel_int: accel-int {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	backlight {
		lcd_light_en: lcd-light-en {
			rockchip,pins = <2 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	panel {
		lcd_pwren_h: lcd-pwren-h {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd_reset: lcd-reset {
			rockchip,pins = <2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	touchscreen {
		tp_int_l: tp-int-l {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		tp_rst_l: tp-rst-l {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm2m2_pins>;
	status = "okay";
};

&vp3 {
	#address-cells = <1>;
	#size-cells = <0>;

	vp3_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
		remote-endpoint = <&dsi1_in_vp3>;
	};
};
